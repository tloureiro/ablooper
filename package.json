{
  "name": "ablooper",
  "version": "1.1.0",
  "description": "A lightweight YouTube A/B looper with shareable sessions.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/state.js --test-coverage-include=scripts/server.js --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=95 tests/unit/*.test.js tests/integration/*.test.js",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:e2e": "playwright test journeys.spec.js",
    "test:a11y": "playwright test accessibility.spec.js",
    "test:live": "playwright test --config=playwright.live.config.js",
    "test:docker": "node scripts/test-in-docker.js",
    "test:report": "playwright show-report",
    "check": "npm run lint && npm run test:coverage && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tloureiro/ablooper.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tloureiro/ablooper/issues"
  },
  "homepage": "https://github.com/tloureiro/ablooper#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
